# LLM gateway settings. LLM_MODE=fake needs no key; gemini uses the key below.
# Copy to .env (gitignored) and put your own key there, never in this file.
LLM_MODE=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=5
# API agent tools: stub (canned synthetic numbers) or registry (the real statistical tools
# when the dataset is built, mock ones otherwise).
WHACK_AGENT_TOOLS=stub
