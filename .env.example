# Normal research requires Gemini credentials. The scripted demo needs no key.
# Copy to .env (gitignored) and put your own key there, never in this file.
LLM_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=5
# The API requires real tools; missing or invalid data never falls back to mocks.
WHACK_AGENT_TOOLS=registry
WHACK_TOOLS=real
